def dgauss(ss, f = 16):
    # TODO: check for error conditions
    # Sample one discrete gaussian sample
    res = Array(1,sint)
    res[0] = sint(0)
    assigned = Array(1,sint)
    assigned[0] = sint(0)

    tmp_assigned = sint(0)
    ss_frac = fractions.Fraction(ss)  # cast to rational for exact arithmetic
    ss_num = sint(ss_frac.numerator)
    ss_den = sint(ss_frac.denominator)

    #TODO: solve this issue t = sint(floorsqrt(ss_frac) + 1)
    t = cint(ceil(sqrt(ss)))

    n_iterations = 10
    @for_range_opt(n_iterations)
    def _(i):
        y, lap_error = d_laplace(t)
        y_abs = abs(y)
        print_ln(y_abs)
        z_num = (ss_den*y_abs*t - ss_num)**2
        z_den = 2* ss_den*ss_num* (t**2)
        #z = (mpc.abs(y) - ss / t)**2 / (2*ss)
        bern = bern_emab(z_num, sint(z_den))
        cond_bern = (bern == 1)
        tmp_res = res[0]
        res[0] = assigned[0] * (tmp_res) + (1-assigned[0])*( (cond_bern) * y + (1-cond_bern)*sint(0))

        tmp_assigned = assigned[0]
        assigned[0] = tmp_assigned * (1-tmp_assigned) * cond_bern
    
    # if assigned == 0, then error
    return res[0], assigned[0]


