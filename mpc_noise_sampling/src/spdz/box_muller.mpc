import Compiler.mpc_math as mpc
from math import exp


# Box-Muller Method Implementation

sfix.set_precision(16, 31)
u_1 = sfix.get_random(0,1)
print_ln("Sampled value u1 = %s", u_1.reveal())

u_2 = sfix.get_random(0,1)
print_ln("Sampled value u2 = %s", u_2.reveal())

const = sfix(-2)

sin_arg = 2 * mpc.pi * u_2

n_1_0 = mpc.sin(sin_arg)
print_ln("Sampled value\t %s", n_1_0.reveal())

n_1_1 = mpc.log_fx(u_1, exp(1))
print_ln("Sampled value\t %s", n_1_1.reveal())

n_1_2 = mpc.sqrt( const * n_1_1)
print_ln("Sampled value\t %s", n_1_2.reveal())

n_1 = n_1_2 * n_1_0
print_ln("Sampled value N1 = %s", n_1.reveal())


n_2_0 = mpc.cos(sin_arg)
n_2 = n_2_0 * n_1_2
print_ln("Sampled value N2 = %s", n_2.reveal())
